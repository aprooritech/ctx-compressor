# ---------------------------------------------------------------------------
# Context-Window Compressor & Local LLM Proxy - example configuration
# Copy to `.env` and adjust. Every value below is optional; the defaults shown
# are the ones baked into src/config.py.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
APP_NAME="Context-Window Compressor Proxy"
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Comma separated list. Empty = proxy accepts unauthenticated requests.
PROXY_API_KEYS=
# Comma separated list of allowed CORS origins ("*" allows everything).
CORS_ALLOW_ORIGINS=*

# --- Provider defaults ------------------------------------------------------
# Used when neither the X-Provider header nor a model prefix selects a backend.
DEFAULT_PROVIDER=ollama
# Retry on a different backend when the primary one is unreachable.
ENABLE_PROVIDER_FALLBACK=false
FALLBACK_PROVIDER=openrouter

# --- Ollama (local) ---------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1
# How long Ollama keeps the model in RAM/VRAM after a request.
OLLAMA_KEEP_ALIVE=5m

# --- OpenRouter (cloud) -----------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
# Optional attribution headers sent to OpenRouter (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=context-compressor-proxy

# --- HTTP client ------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=120.0
CONNECT_TIMEOUT_SECONDS=10.0
MAX_CONNECTIONS=100
MAX_KEEPALIVE_CONNECTIONS=20

# --- Compression engine -----------------------------------------------------
COMPRESSION_ENABLED=true
# Hard prompt budget X. Compression starts above (X - RESERVE_OUTPUT_TOKENS).
MAX_CONTEXT_TOKENS=8192
# Tokens kept free for the completion itself.
RESERVE_OUTPUT_TOKENS=1024
# Compression target = trigger threshold * ratio (0 < ratio <= 1).
COMPRESSION_TARGET_RATIO=0.6
# N most recent messages that always stay verbatim (short-term memory).
KEEP_LAST_MESSAGES=6
# none | trim | summarize | hybrid  (hybrid = summarize, then trim if needed)
COMPRESSION_STRATEGY=hybrid

# --- Summarisation (long-term memory) --------------------------------------
# Empty = summarise with the same provider/model as the actual request.
SUMMARY_PROVIDER=
SUMMARY_MODEL=
SUMMARY_MAX_TOKENS=512
# Size of one map-reduce chunk fed to the summariser.
SUMMARY_CHUNK_TOKENS=1500
# Maximum recursion depth for summarising summaries.
SUMMARY_MAX_DEPTH=3
# Role of the injected summary message: system | user | assistant
SUMMARY_MESSAGE_ROLE=system
SUMMARY_TIMEOUT_SECONDS=60.0
# Retries per chunk on transient failures (rate limits, brief outages).
SUMMARY_RETRY_ATTEMPTS=2
SUMMARY_RETRY_BACKOFF_SECONDS=1.0

# --- Trimming ---------------------------------------------------------------
# Per-message cap when messages get trimmed instead of summarised.
TRIM_MESSAGE_MAX_TOKENS=200

# --- Tokenizer --------------------------------------------------------------
# tiktoken | huggingface | approx  (falls back to approx when unavailable)
TOKENIZER_BACKEND=tiktoken
TIKTOKEN_ENCODING=cl100k_base
HF_TOKENIZER_NAME=meta-llama/Meta-Llama-3-8B-Instruct
# Deadline for the vocabulary download at startup; the approximation takes over after it.
TOKENIZER_INIT_TIMEOUT_SECONDS=10.0

# --- Persistence / observability -------------------------------------------
DB_ENABLED=true
DB_PATH=data/proxy.db
DB_BUSY_TIMEOUT_MS=5000
# Store a short preview of the first user message (privacy sensitive!).
PERSIST_MESSAGE_PREVIEW=false
